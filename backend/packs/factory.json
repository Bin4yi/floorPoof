 "rules": [
  {
   "id": "FP-OVERLAP",
   "kind": "overlap",
   "title": "No two items on the same floor cell, and no item off the floor",
   "params": {},
   "status": "no_number",
   "source_url": null,
   "source_note": "Physical constraint. No number needed."
  },
  {
   "id": "FP-EXIT-REACH",
   "kind": "exit_reach",
   "title": "Every work position can walk to an exit, and no exit is blocked",
   "params": {},
   "status": "sourced",
   "source_url": "https://www.osha.gov/laws-regs/regulations/standardnumber/1910/1910.37",
   "source_note": "OSHA 29 CFR 1910.37(a)(3): exit routes must be free and unobstructed."
  },
  {
   "id": "FP-EXIT-DIST",
   "kind": "exit_distance",
   "title": "Walk from each work position to the nearest exit is within the limit",
   "params": {
    "max_m_unsprinklered": 60.96,
    "max_m_sprinklered": 76.2
   },
   "status": "sourced",
   "source_url": "https://lawfilesext.leg.wa.gov/Law/WACArchive/2024/htm/WAC%20%2051%20-%2054A%20CHAPTER/WAC%20%2051%20-%2054A-1017.htm",
   "source_note": "IBC Table 1017.2 (as adopted in WAC 51-54A-1017), occupancy F-1: 200 ft without sprinklers, 250 ft with sprinklers."
  },
  {
   "id": "FP-AISLE",
   "kind": "aisle_width",
   "title": "Main aisles keep a clear width at every point",
   "params": {
    "min_m": 0.711,
    "zone_kind": "aisle"
   },
   "status": "sourced",
   "source_url": "https://www.osha.gov/laws-regs/regulations/standardnumber/1910/1910.36",
   "source_note": "OSHA 29 CFR 1910.36(g)(2): an exit access must be at least 28 inches (71.1 cm) wide at all points."
  },
  {
   "id": "FP-PANEL",
   "kind": "panel_load",
   "title": "No drop box, sub-panel or main breaker over its continuous-load limit",
   "params": {
    "continuous_factor": 1.25
   },
   "status": "sourced",
   "source_url": "https://iaeimagazine.org/2016/may2016/100-vs-80-choosing-the-right-ocpd-solution/",
   "source_note": "NEC 210.20(A): device rating at least noncontinuous load plus 125% of continuous load, so a continuous load may use at most 80% of the rating. All machines are treated as continuous (3 h or more)."
  },
  {
   "id": "FP-SEP",
   "kind": "separation",
   "title": "Hot machines are far enough from fabric storage",
   "params": {},
   "status": "TBD",
   "source_url": null,
   "source_note": "Minimum distance between pressing machines and fabric racks: no source yet (TBD)."
  },
  {
   "id": "FP-LINE",
   "kind": "line_flow",
   "title": "Work moves forward along each line",
   "params": {
    "max_step_m": "TBD"
   },
   "status": "partial",
   "source_url": null,
   "source_note": "Process rule: each step sits further along the line direction than the one before. Maximum distance between steps: TBD."
  }
 ]
